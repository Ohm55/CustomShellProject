CC = gcc
CFLAGS = -std=c11 -O2 -Wall -Wextra -Wpedantic

.PHONY: all test clean
all: hamani_loganalyzer

hamani_loganalyzer: hamani_loganalyzer.c hamani_loganalyzer.h
	$(CC) $(CFLAGS) -DLOGANALYZER_STANDALONE hamani_loganalyzer.c -o hamani_loganalyzer

test: hamani_loganalyzer
	sh hamani_loganalyzer_test.sh
	$(CC) $(CFLAGS) -I. hamani_loganalyzer.c tests/hamani_loganalyzer_repeat_calls.c -o hamani_loganalyzer_test_repeat_calls
	./hamani_loganalyzer_test_repeat_calls > /dev/null 2>&1
	@echo 'Repeated shell calls passed.'
	rm -f hamani_loganalyzer_test_repeat_calls

clean:
	rm -f hamani_loganalyzer hamani_loganalyzer.o hamani_loganalyzer_test_repeat_calls
